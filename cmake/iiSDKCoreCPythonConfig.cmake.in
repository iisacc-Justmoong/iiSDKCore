@PACKAGE_INIT@
set(iiSDKCoreCPython_SPDX_LICENSE "Apache-2.0")
include(CMakeFindDependencyMacro)
find_dependency(iiSDKCore 0.20 CONFIG COMPONENTS Runtime)
find_dependency(Python @Python_VERSION_MAJOR@.@Python_VERSION_MINOR@ EXACT COMPONENTS Development.Embed)
include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreCPythonTargets.cmake")
set_property(TARGET iiSDKCore::CPython PROPERTY IISDK_CPYTHON_EXTENSION_SUFFIX "@_cpython_suffix@")
if(APPLE AND TARGET Python::Python)
    get_target_property(_iisdk_cpython_library Python::Python IMPORTED_LOCATION)
    if(NOT _iisdk_cpython_library AND Python_LIBRARY)
        set(_iisdk_cpython_library "${Python_LIBRARY}")
    endif()
    if(_iisdk_cpython_library AND EXISTS "${_iisdk_cpython_library}")
        get_filename_component(_iisdk_cpython_real "${_iisdk_cpython_library}" REALPATH)
        if(_iisdk_cpython_real MATCHES "^(.*)/Python[0-9]*\\.framework/Versions/")
            set(_iisdk_cpython_rpath "LINKER:-rpath,${CMAKE_MATCH_1}")
            get_target_property(_iisdk_cpython_options iiSDKCore::CPython INTERFACE_LINK_OPTIONS)
            if(NOT _iisdk_cpython_rpath IN_LIST _iisdk_cpython_options)
                target_link_options(iiSDKCore::CPython INTERFACE "${_iisdk_cpython_rpath}")
            endif()
        endif()
    endif()
endif()
check_required_components(iiSDKCoreCPython)
