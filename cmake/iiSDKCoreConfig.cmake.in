@PACKAGE_INIT@
set(iiSDKCore_SPDX_LICENSE "Apache-2.0")
if(EMSCRIPTEN)
    # Emscripten supports side modules although its CMake toolchain defaults
    # the shared-library capability to false.
    set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
endif()
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreEmbeddedTargets.cmake")
set(iiSDKCore_Embedded_FOUND TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreContractsTargets.cmake")
set(iiSDKCore_Contracts_FOUND TRUE)
set(_iisdkcore_runtime FALSE)
set(_iisdkcore_values FALSE)
set(_iisdkcore_observation FALSE)
if(NOT iiSDKCore_FIND_COMPONENTS)
    set(_iisdkcore_runtime TRUE)
    set(_iisdkcore_values TRUE)
endif()
foreach(_component IN LISTS iiSDKCore_FIND_COMPONENTS)
    if(_component STREQUAL "Runtime")
        set(_iisdkcore_runtime TRUE)
    elseif(_component STREQUAL "Values")
        set(_iisdkcore_values TRUE)
    elseif(_component STREQUAL "Observation")
        set(_iisdkcore_observation TRUE)
    elseif(NOT _component STREQUAL "Contracts" AND NOT _component STREQUAL "Embedded")
        set(iiSDKCore_${_component}_FOUND FALSE)
    endif()
endforeach()
if(_iisdkcore_runtime OR _iisdkcore_observation)
    include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreObservationTargets.cmake")
    set(iiSDKCore_Observation_FOUND TRUE)
endif()
if(_iisdkcore_values)
    include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreValuesTargets.cmake")
    set(iiSDKCore_Values_FOUND TRUE)
endif()
if(_iisdkcore_runtime)
    find_dependency(Threads)
    include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreTargets.cmake")
    if(EMSCRIPTEN AND TARGET iiSDKCore::Observation)
        # emcc resolves a side module's dylink dependencies through -L, even
        # when the dependency is also present later as an absolute link input.
        set_property(TARGET iiSDKCore::iiSDKCore APPEND PROPERTY INTERFACE_LINK_DIRECTORIES
            "$<TARGET_FILE_DIR:iiSDKCore::Observation>")
    endif()
    if(NOT TARGET iiSDKCore::Runtime)
        add_library(iiSDKCore::Runtime INTERFACE IMPORTED)
        set_property(TARGET iiSDKCore::Runtime PROPERTY INTERFACE_LINK_LIBRARIES iiSDKCore::iiSDKCore)
    endif()
    set(iiSDKCore_Runtime_FOUND TRUE)
endif()
check_required_components(iiSDKCore)
include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreApplication.cmake")
