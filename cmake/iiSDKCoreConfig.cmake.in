@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreContractsTargets.cmake")
set(iiSDKCore_Contracts_FOUND TRUE)
set(_iisdkcore_runtime FALSE)
set(_iisdkcore_values FALSE)
if(NOT iiSDKCore_FIND_COMPONENTS)
    set(_iisdkcore_runtime TRUE)
    set(_iisdkcore_values TRUE)
endif()
foreach(_component IN LISTS iiSDKCore_FIND_COMPONENTS)
    if(_component STREQUAL "Runtime")
        set(_iisdkcore_runtime TRUE)
    elseif(_component STREQUAL "Values")
        set(_iisdkcore_values TRUE)
    elseif(NOT _component STREQUAL "Contracts")
        set(iiSDKCore_${_component}_FOUND FALSE)
    endif()
endforeach()
if(_iisdkcore_values)
    include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreValuesTargets.cmake")
    set(iiSDKCore_Values_FOUND TRUE)
endif()
if(_iisdkcore_runtime)
    find_dependency(Threads)
    include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreTargets.cmake")
    if(NOT TARGET iiSDKCore::Runtime)
        add_library(iiSDKCore::Runtime INTERFACE IMPORTED)
        set_property(TARGET iiSDKCore::Runtime PROPERTY INTERFACE_LINK_LIBRARIES iiSDKCore::iiSDKCore)
    endif()
    set(iiSDKCore_Runtime_FOUND TRUE)
endif()
check_required_components(iiSDKCore)
include("${CMAKE_CURRENT_LIST_DIR}/iiSDKCoreApplication.cmake")
