include_guard(GLOBAL)
function(iisdkcore_add_application target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "GUI" "" "SOURCES;LIBRARIES;RESOURCES")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_SOURCES)
        message(FATAL_ERROR "iisdkcore_add_application requires SOURCES and optional GUI / LIBRARIES")
    endif()
    if(NOT TARGET iiSDKCore::Runtime)
        message(FATAL_ERROR "iisdkcore_add_application requires find_package(iiSDKCore CONFIG COMPONENTS Runtime)")
    endif()
    set(_entry "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ApplicationEntry.cpp")
    if(NOT EXISTS "${_entry}")
        set(_entry "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/Runtime/ApplicationEntry.cpp")
    endif()
    add_executable(${target} "${_entry}" ${ARG_SOURCES})
    target_compile_features(${target} PRIVATE cxx_std_23)
    target_link_libraries(${target} PRIVATE iiSDKCore::Runtime ${ARG_LIBRARIES})
    set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF IISDKCORE_APPLICATION_ENTRY "${_entry}")
    if(ARG_GUI)
        if(APPLE)
            set_target_properties(${target} PROPERTIES MACOSX_BUNDLE TRUE)
        elseif(WIN32)
            set_target_properties(${target} PROPERTIES WIN32_EXECUTABLE TRUE)
            if(MSVC)
                target_link_options(${target} PRIVATE /ENTRY:mainCRTStartup)
            endif()
        endif()
    endif()
    if(ARG_RESOURCES)
        target_sources(${target} PRIVATE ${ARG_RESOURCES})
        if(APPLE AND ARG_GUI)
            set_source_files_properties(${ARG_RESOURCES} PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
        else()
            foreach(_resource IN LISTS ARG_RESOURCES)
                add_custom_command(TARGET ${target} POST_BUILD
                    COMMAND "${CMAKE_COMMAND}" -E make_directory "$<TARGET_FILE_DIR:${target}>/resources"
                    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_resource}" "$<TARGET_FILE_DIR:${target}>/resources/"
                    VERBATIM)
            endforeach()
        endif()
    endif()
endfunction()
