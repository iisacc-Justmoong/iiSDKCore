# The policy is a host build check; Python is never a runtime dependency.
find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)

function(_iisdkcore_json_array result)
    set(_items)
    foreach(_item IN LISTS ARGN)
        string(REPLACE "\\" "\\\\" _item "${_item}")
        string(REPLACE "\"" "\\\"" _item "${_item}")
        string(REPLACE "\n" "\\n" _item "${_item}")
        list(APPEND _items "\"${_item}\"")
    endforeach()
    list(JOIN _items "," _joined)
    set(${result} "[${_joined}]" PARENT_SCOPE)
endfunction()

function(iisdkcore_enforce_architecture)
    get_property(_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    set(_units)
    set(_contexts)
    set(_checked_targets)
    foreach(_target IN LISTS _targets)
        get_target_property(_type "${_target}" TYPE)
        if(_type MATCHES "^(EXECUTABLE|STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY)$")
            list(APPEND _checked_targets "${_target}")
            get_target_property(_sources "${_target}" SOURCES)
            set(_target_sources)
            foreach(_source IN LISTS _sources)
                if(_source MATCHES "\\.(cpp|cc|cxx|mm)$")
                    cmake_path(ABSOLUTE_PATH _source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
                    list(APPEND _units "${_source}")
                    list(APPEND _target_sources "${_source}")
                endif()
            endforeach()
            _iisdkcore_json_array(_target_sources_json ${_target_sources})
            get_target_property(_export "${_target}" DEFINE_SYMBOL)
            if(_type STREQUAL "SHARED_LIBRARY")
                if(NOT _export)
                    set(_export "${_target}_EXPORTS")
                endif()
            else()
                set(_export "")
            endif()
            set(_pic_options "")
            if(NOT MSVC)
                if(_type STREQUAL "EXECUTABLE")
                    set(_pic_options "$<$<BOOL:$<TARGET_PROPERTY:${_target},POSITION_INDEPENDENT_CODE>>:${CMAKE_CXX_COMPILE_OPTIONS_PIE}>")
                else()
                    set(_pic_options "$<$<BOOL:$<TARGET_PROPERTY:${_target},POSITION_INDEPENDENT_CODE>>:${CMAKE_CXX_COMPILE_OPTIONS_PIC}>")
                endif()
            endif()
            set(_context "${CMAKE_CURRENT_BINARY_DIR}/architecture/${_target}-$<CONFIG>.txt")
            file(GENERATE OUTPUT "${_context}" CONTENT
"[options]\n$<JOIN:$<TARGET_PROPERTY:${_target},COMPILE_OPTIONS>,\n>\n${_pic_options}\n[include_dirs]\n$<JOIN:$<TARGET_PROPERTY:${_target},INCLUDE_DIRECTORIES>,\n>\n[definitions]\n$<JOIN:$<TARGET_PROPERTY:${_target},COMPILE_DEFINITIONS>,\n>\n${_export}\n[standard]\n$<TARGET_PROPERTY:${_target},CXX_STANDARD>\n[extensions]\n$<TARGET_PROPERTY:${_target},CXX_EXTENSIONS>\n" TARGET "${_target}")
            _iisdkcore_json_array(_context_json "${_context}")
            string(REGEX REPLACE "^\\[|\\]$" "" _context_value "${_context_json}")
            list(APPEND _contexts "{\"file\":${_context_value},\"sources\":${_target_sources_json}}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _units)
    list(JOIN _contexts "," _contexts_json)
    _iisdkcore_json_array(_units_json ${_units})
    _iisdkcore_json_array(_includes_json "${CMAKE_CURRENT_SOURCE_DIR}/src" "${CMAKE_CURRENT_BINARY_DIR}/include")
    _iisdkcore_json_array(_compiler_json "${CMAKE_CXX_COMPILER}")
    _iisdkcore_json_array(_root_json "${CMAKE_CURRENT_SOURCE_DIR}")
    _iisdkcore_json_array(_generated_json "${CMAKE_CURRENT_BINARY_DIR}/include")

    separate_arguments(_flags NATIVE_COMMAND "${CMAKE_CXX_COMPILER_ARG1} ${CMAKE_CXX_FLAGS}")
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
        set(_msvc true)
    else()
        set(_msvc false)
        if(CMAKE_CXX_COMPILER_TARGET)
            list(APPEND _flags "--target=${CMAKE_CXX_COMPILER_TARGET}")
        endif()
        if(CMAKE_SYSROOT)
            list(APPEND _flags "--sysroot=${CMAKE_SYSROOT}")
        endif()
        if(CMAKE_OSX_SYSROOT)
            set(_sysroot "${CMAKE_OSX_SYSROOT}")
            if(NOT IS_DIRECTORY "${_sysroot}")
                execute_process(COMMAND xcrun --sdk "${_sysroot}" --show-sdk-path
                    OUTPUT_VARIABLE _sysroot OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
            endif()
            list(APPEND _flags -isysroot "${_sysroot}")
        endif()
        if(CMAKE_OSX_DEPLOYMENT_TARGET AND CMAKE_CXX_OSX_DEPLOYMENT_TARGET_FLAG)
            list(APPEND _flags "${CMAKE_CXX_OSX_DEPLOYMENT_TARGET_FLAG}${CMAKE_OSX_DEPLOYMENT_TARGET}")
        endif()
    endif()
    _iisdkcore_json_array(_architectures_json ${CMAKE_OSX_ARCHITECTURES})
    _iisdkcore_json_array(_flags_json ${_flags})
    set(_standard_options)
    foreach(_feature IN LISTS CMAKE_CXX_COMPILE_FEATURES)
        if(_feature MATCHES "^cxx_std_([0-9]+)$")
            set(_standard "${CMAKE_MATCH_1}")
            _iisdkcore_json_array(_strict ${CMAKE_CXX${_standard}_STANDARD_COMPILE_OPTION})
            _iisdkcore_json_array(_extensions ${CMAKE_CXX${_standard}_EXTENSION_COMPILE_OPTION})
            list(APPEND _standard_options "\"${_standard}\":{\"strict\":${_strict},\"extensions\":${_extensions}}")
        endif()
    endforeach()
    list(JOIN _standard_options "," _standard_options)
    if(CMAKE_CXX_EXTENSIONS_DEFAULT)
        set(_extensions_default true)
    else()
        set(_extensions_default false)
    endif()
    set(_configuration_flags)
    foreach(_configuration DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
        separate_arguments(_config_flags NATIVE_COMMAND "${CMAKE_CXX_FLAGS_${_configuration}}")
        _iisdkcore_json_array(_config_json ${_config_flags})
        list(APPEND _configuration_flags "\"${_configuration}\":${_config_json}")
    endforeach()
    list(JOIN _configuration_flags "," _configuration_flags)

    # Build JSON as ordinary strings; paths remain valid on Windows as well.
    string(REGEX REPLACE "^\\[|\\]$" "" _root_value "${_root_json}")
    string(REGEX REPLACE "^\\[|\\]$" "" _compiler_value "${_compiler_json}")
    string(REGEX REPLACE "^\\[|\\]$" "" _generated_value "${_generated_json}")
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/architecture/config-$<CONFIG>.json" CONTENT
"{\"root\":${_root_value},\"compiler\":${_compiler_value},\"generated_include\":${_generated_value},\"configuration\":\"$<CONFIG>\",\"configuration_flags\":{${_configuration_flags}},\"msvc\":${_msvc},\"architectures\":${_architectures_json},\"flags\":${_flags_json},\"definitions\":[],\"include_dirs\":${_includes_json},\"standard_options\":{${_standard_options}},\"extensions_default\":${_extensions_default},\"translation_units\":${_units_json},\"contexts\":[${_contexts_json}]}\n")
    set(_manifest "${CMAKE_CURRENT_BINARY_DIR}/architecture/config-$<CONFIG>.json")
    add_custom_target(iiSDKCoreArchitectureCheck ALL
        COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/check_inheritance.py"
            --config "${_manifest}" --cache "${CMAKE_CURRENT_BINARY_DIR}/architecture/cache-$<CONFIG>.json"
        VERBATIM COMMENT "Enforcing sealed public records and no multiple inheritance")
    foreach(_target IN LISTS _checked_targets)
        add_dependencies("${_target}" iiSDKCoreArchitectureCheck)
    endforeach()
    if(BUILD_TESTING)
        add_test(NAME iiSDKCore.Architecture
            COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/architecture_policy.py"
                --config "${_manifest}" --build "${CMAKE_CURRENT_BINARY_DIR}/architecture/tests")
        set_tests_properties(iiSDKCore.Architecture PROPERTIES TIMEOUT 60)
    endif()
endfunction()
